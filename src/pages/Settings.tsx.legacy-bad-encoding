import { useEffect, useMemo, useState } from 'react';
import { Camera, Copy, CreditCard, ExternalLink, Link2, MapPin, MessageCircle, MessageSquareLock, Palette, Send, ShieldCheck, Store, UserRound } from 'lucide-react';

import { AppShell } from '@/components/app/AppShell';
import { MetricCard } from '@/components/app/MetricCard';
import { Panel } from '@/components/app/Panel';
import { Button } from '@/components/ui/button';
import { useAuth } from '@/context/AuthContext';
import { useLocale } from '@/context/LocaleContext';
import { useOwnerWorkspace } from '@/hooks/useOwnerWorkspace';
import { authAPI, ownerAPI, type AppUser, type OwnerReviewsProfileResponse, type TelegramLinkResponse } from '@/services/api';

type ReviewsProfileForm = {
  primary_color: string;
  secondary_color: string;
  phone_number: string;
  address: string;
  review_category: string;
  review_short_description: string;
  review_features: string;
  working_hours_text: string;
  average_check_text: string;
  map_link: string;
  telegram_url: string;
  instagram_url: string;
  whatsapp_url: string;
  clear_reviews_logo: boolean;
  clear_reviews_cover: boolean;
};

const emptyReviewsForm: ReviewsProfileForm = {
  primary_color: '#0f766e',
  secondary_color: '#0f172a',
  phone_number: '',
  address: '',
  review_category: '',
  review_short_description: '',
  review_features: '',
  working_hours_text: '',
  average_check_text: '',
  map_link: '',
  telegram_url: '',
  instagram_url: '',
  whatsapp_url: '',
  clear_reviews_logo: false,
  clear_reviews_cover: false,
};

export default function SettingsPage() {
  const { user, replaceUser } = useAuth();
  const { t, locale } = useLocale();
  const workspace = useOwnerWorkspace(user?.role === 'RESTAURANT_OWNER' || user?.role === 'CHAIN_OWNER');
  const [telegramLoading, setTelegramLoading] = useState(false);
  const [telegramError, setTelegramError] = useState('');
  const [telegramInfo, setTelegramInfo] = useState('');
  const [linkData, setLinkData] = useState<TelegramLinkResponse | null>(null);

  const [reviewsLoading, setReviewsLoading] = useState(false);
  const [reviewsSaving, setReviewsSaving] = useState(false);
  const [reviewsError, setReviewsError] = useState('');
  const [reviewsInfo, setReviewsInfo] = useState('');
  const [reviewsProfile, setReviewsProfile] = useState<OwnerReviewsProfileResponse | null>(null);
  const [reviewsForm, setReviewsForm] = useState<ReviewsProfileForm>(emptyReviewsForm);
  const [logoFile, setLogoFile] = useState<File | null>(null);
  const [coverFile, setCoverFile] = useState<File | null>(null);

  const profile = useMemo(
    () => ({
      ...workspace.profile,
      ...user,
    }),
    [user, workspace.profile],
  );

  const syncUser = (nextUser?: AppUser) => {
    if (!nextUser) return;
    replaceUser({ ...(user || {}), ...nextUser });
    workspace.reload();
  };

  const applyReviewsProfile = (payload: OwnerReviewsProfileResponse) => {
    setReviewsProfile(payload);
    setReviewsForm({
      primary_color: payload.primary_color || '#0f766e',
      secondary_color: payload.secondary_color || '#0f172a',
      phone_number: payload.phone_number || '',
      address: payload.address || '',
      review_category: payload.review_category || '',
      review_short_description: payload.review_short_description || '',
      review_features: payload.review_features || '',
      working_hours_text: payload.working_hours_text || '',
      average_check_text: payload.average_check_text || '',
      map_link: payload.map_link || '',
      telegram_url: payload.telegram_url || '',
      instagram_url: payload.instagram_url || '',
      whatsapp_url: payload.whatsapp_url || '',
      clear_reviews_logo: false,
      clear_reviews_cover: false,
    });
    setLogoFile(null);
    setCoverFile(null);
  };

  useEffect(() => {
    if (!workspace.selectedRestaurantId) {
      setReviewsProfile(null);
      setReviewsForm(emptyReviewsForm);
      return;
    }

    let active = true;
    setReviewsLoading(true);
    setReviewsError('');

    ownerAPI.getReviewsProfile(workspace.selectedRestaurantId)
      .then((response) => {
        if (!active) return;
        applyReviewsProfile(response.data);
        setReviewsLoading(false);
      })
      .catch((err: any) => {
        if (!active) return;
        setReviewsError(err?.response?.data?.error || 'Failed to load reviews profile settings.');
        setReviewsLoading(false);
      });

    return () => {
      active = false;
    };
  }, [workspace.selectedRestaurantId]);

  const handleRequestLink = async () => {
    const telegramWindow = window.open('', '_blank', 'noopener,noreferrer');
    setTelegramLoading(true);
    setTelegramError('');
    setTelegramInfo('');
    try {
      const response = await authAPI.requestTelegramLink();
      setLinkData(response.data);
      if (response.data.bot_url) {
        if (telegramWindow) {
          telegramWindow.location.href = response.data.bot_url;
        } else {
          window.open(response.data.bot_url, '_blank', 'noopener,noreferrer');
        }
        setTelegramInfo(locale === 'uz' ? 'Telegram boti yangi oynada ochildi. Profilingizdagi shu telefon raqamini yuboring.' : 'Telegram-бот открыт в новой вкладке. Отправьте тот же номер, который сохранен в вашем профиле.');
        return;
      }
      if (telegramWindow) telegramWindow.close();
      setTelegramInfo(locale === 'uz' ? 'Boglash kodi yaratildi. Botga profilingizdagi shu telefon raqamini yuboring.' : 'Код привязки создан. Отправьте в бота тот же номер, который сохранен в профиле.');
    } catch (err: any) {
      if (telegramWindow) telegramWindow.close();
      setTelegramError(err?.response?.data?.error || (locale === 'uz' ? 'Telegram kodi yaratilmadi.' : 'Не удалось создать Telegram-код.'));
    } finally {
      setTelegramLoading(false);
    }
  };

  const handleConfirmLink = async () => {
    if (!linkData?.link_code) return;
    setTelegramLoading(true);
    setTelegramError('');
    setTelegramInfo('');
    try {
      const response = await authAPI.confirmTelegramLink({ link_code: linkData.link_code });
      if (response.data.user) {
        syncUser(response.data.user);
        setTelegramInfo(locale === 'uz' ? 'Telegram muvaffaqiyatli ulandi.' : 'Telegram успешно подключен.');
        setLinkData(null);
      } else {
        setTelegramInfo(response.data.message || (locale === 'uz' ? 'Tasdiq hali kutilmoqda.' : 'Подтверждение еще ожидается.'));
      }
    } catch (err: any) {
      setTelegramError(err?.response?.data?.error || (locale === 'uz' ? 'Telegram hali tasdiqlamadi.' : 'Telegram еще не подтвердил привязку.'));
    } finally {
      setTelegramLoading(false);
    }
  };

  const handleUnlink = async () => {
    setTelegramLoading(true);
    setTelegramError('');
    setTelegramInfo('');
    try {
      const response = await authAPI.unlinkTelegram();
      syncUser(response.data.user);
      setLinkData(null);
      setTelegramInfo(locale === 'uz' ? 'Telegram auth ochirildi.' : 'Telegram-аутентификация отключена.');
    } catch (err: any) {
      setTelegramError(err?.response?.data?.error || (locale === 'uz' ? 'Telegram auth ochirilmadi.' : 'Не удалось отключить Telegram-аутентификацию.'));
    } finally {
      setTelegramLoading(false);
    }
  };

  const handleCopy = async (value: string) => {
    try {
      await navigator.clipboard.writeText(value);
      setTelegramInfo(locale === 'uz' ? 'Buferga nusxalandi.' : 'Скопировано в буфер обмена.');
    } catch {
      setTelegramError(locale === 'uz' ? 'Kod qolda nusxalansin.' : 'Скопируйте код вручную.');
    }
  };

  const handleReviewsField = (field: keyof ReviewsProfileForm, value: string | boolean) => {
    setReviewsForm((current) => ({
      ...current,
      [field]: value,
    }));
  };

  const handleSaveReviewsProfile = async () => {
    if (!workspace.selectedRestaurantId) return;
    setReviewsSaving(true);
    setReviewsError('');
    setReviewsInfo('');

    try {
      const payload = new FormData();
      payload.append('restaurant_id', workspace.selectedRestaurantId);
      Object.entries(reviewsForm).forEach(([key, value]) => {
        payload.append(key, typeof value === 'boolean' ? String(value) : value);
      });
      if (logoFile) payload.append('reviews_logo', logoFile);
      if (coverFile) payload.append('reviews_cover', coverFile);

      const response = await ownerAPI.updateReviewsProfile(workspace.selectedRestaurantId, payload);
      applyReviewsProfile(response.data);
      setReviewsInfo(locale === 'uz' ? 'Reviews profili saqlandi.' : 'Профиль reviews сохранен.');
    } catch (err: any) {
      setReviewsError(err?.response?.data?.error || 'Failed to save reviews profile.');
    } finally {
      setReviewsSaving(false);
    }
  };

  const telegramLinked = Boolean(profile?.telegram_linked);
  const logoPreviewUrl = logoFile ? URL.createObjectURL(logoFile) : (!reviewsForm.clear_reviews_logo ? reviewsProfile?.reviews_logo_url : '');
  const coverPreviewUrl = coverFile ? URL.createObjectURL(coverFile) : (!reviewsForm.clear_reviews_cover ? reviewsProfile?.reviews_cover_url : '');

  return (
    <AppShell
      title={t('settings_title', 'Профиль и безопасность')}
      subtitle={t('settings_subtitle', 'Основные данные аккаунта и безопасные способы входа для владельца.')}
      eyebrow={locale === 'uz' ? 'Profil' : 'Профиль'}
      restaurants={workspace.restaurants}
      selectedRestaurantId={workspace.selectedRestaurantId}
      onRestaurantChange={workspace.setSelectedRestaurantId}
    >
      <div className="space-y-4">
        <div className="grid gap-4 md:grid-cols-2">
          <MetricCard title={locale === 'uz' ? 'Profil' : 'Профиль'} value={user?.full_name || (locale === 'uz' ? 'Foydalanuvchi' : 'Пользователь')} note={user?.role || (locale === 'uz' ? 'Rol korsatilmagan' : 'Роль не указана')} icon={UserRound} tone="coral" />
          <MetricCard title={locale === 'uz' ? 'Ish maydonlari' : 'Рабочие зоны'} value={workspace.restaurants.length || workspace.profile?.chains?.length || 0} note={locale === 'uz' ? 'Profilga ulangan restoran yoki tarmoqlar' : 'Рестораны или сети, привязанные к профилю'} icon={CreditCard} tone="sand" />
        </div>

        <div className="grid gap-4 xl:grid-cols-[1.15fr_0.85fr]">
          <Panel title={locale === 'uz' ? 'Akkaunt kartasi' : 'Карточка аккаунта'} eyebrow={locale === 'uz' ? 'Malumotlar' : 'Данные'} description={locale === 'uz' ? 'Owner yoki admin uchun asosiy malumotlar.' : 'Основные данные владельца или администратора.'}>
            <div className="grid gap-4 md:grid-cols-2">
              <div className="rounded-[24px] border border-white/8 bg-black/12 p-5">
                <div className="text-xs uppercase tracking-[0.28em] text-white/40">{locale === 'uz' ? 'Ism' : 'Имя'}</div>
                <div className="mt-2 text-xl font-semibold text-white">{profile?.full_name || (locale === 'uz' ? 'Foydalanuvchi' : 'Пользователь')}</div>
              </div>
              <div className="rounded-[24px] border border-white/8 bg-black/12 p-5">
                <div className="text-xs uppercase tracking-[0.28em] text-white/40">Email</div>
                <div className="mt-2 text-xl font-semibold text-white">{profile?.email || '—'}</div>
              </div>
              <div className="rounded-[24px] border border-white/8 bg-black/12 p-5">
                <div className="text-xs uppercase tracking-[0.28em] text-white/40">{locale === 'uz' ? 'Telefon' : 'Телефон'}</div>
                <div className="mt-2 text-xl font-semibold text-white">{profile?.phone_number || profile?.phone || '—'}</div>
              </div>
              <div className="rounded-[24px] border border-white/8 bg-black/12 p-5">
                <div className="text-xs uppercase tracking-[0.28em] text-white/40">{locale === 'uz' ? 'Rol' : 'Роль'}</div>
                <div className="mt-2 text-xl font-semibold text-white">{profile?.role || '—'}</div>
              </div>
            </div>
          </Panel>

          <Panel title={locale === 'uz' ? 'Telegram auth' : 'Telegram auth'} eyebrow={locale === 'uz' ? 'Kirish va tiklash' : 'Вход и восстановление'} description={locale === 'uz' ? 'Telegram bir marta ulanadi va keyin login hamda recovery uchun ishlaydi.' : 'Telegram подключается один раз и потом используется для входа и восстановления пароля.'}>
            <div className="rounded-[24px] border border-white/8 bg-black/12 p-5">
              <div className="flex items-start justify-between gap-4">
                <div className="flex items-start gap-3">
                  <div className={`grid h-12 w-12 place-items-center rounded-2xl ${telegramLinked ? 'bg-[linear-gradient(135deg,rgba(34,197,94,0.22),rgba(143,212,255,0.22))]' : 'bg-[linear-gradient(135deg,rgba(125,211,252,0.22),rgba(249,115,96,0.18))]'}`}>
                    {telegramLinked ? <ShieldCheck className="h-5 w-5 text-[#9ae6b4]" /> : <MessageSquareLock className="h-5 w-5 text-[#8fd4ff]" />}
                  </div>
                  <div>
                    <div className="text-sm font-semibold text-white">Telegram</div>
                    <div className="mt-1 text-sm text-white/48">
                      {telegramLinked
                        ? locale === 'uz'
                          ? `Ulangan${profile?.telegram_username ? `: @${profile.telegram_username}` : ''}.`
                          : `Подключено${profile?.telegram_username ? ` как @${profile.telegram_username}` : ''}.`
                        : locale === 'uz'
                          ? 'OTP va recovery uchun Telegram chatni ulang.'
                          : 'Подключите Telegram-чат для OTP и восстановления пароля.'}
                    </div>
                  </div>
                </div>
                <div className={`rounded-full px-3 py-1 text-xs font-semibold ${telegramLinked ? 'bg-emerald-500/12 text-emerald-200' : 'bg-white/8 text-white/55'}`}>
                  {telegramLinked ? (locale === 'uz' ? 'Ulangan' : 'Подключено') : locale === 'uz' ? 'Ulanmagan' : 'Не подключено'}
                </div>
              </div>

              <div className="mt-5 flex flex-wrap gap-3">
                {!telegramLinked ? (
                  <>
                    <Button variant="default" size="sm" onClick={handleRequestLink} disabled={telegramLoading}>
                      <Link2 className="mr-2 h-4 w-4" /> {linkData ? (locale === 'uz' ? 'Kodni yangilash' : 'Обновить код') : locale === 'uz' ? 'Telegram ulash' : 'Подключить Telegram'}
                    </Button>
                    {linkData ? <Button variant="outline" size="sm" onClick={handleConfirmLink} disabled={telegramLoading}>{locale === 'uz' ? 'Tasdiqlash' : 'Подтвердить'}</Button> : null}
                  </>
                ) : (
                  <Button variant="outline" size="sm" onClick={handleUnlink} disabled={telegramLoading}>{locale === 'uz' ? 'Telegramni ochirish' : 'Отключить Telegram'}</Button>
                )}
              </div>

              {linkData ? (
                <div className="mt-5 rounded-[22px] border border-dashed border-[#8fd4ff]/25 bg-[#081a28] p-4">
                  <div className="text-[11px] font-semibold uppercase tracking-[0.28em] text-[#8fd4ff]">{locale === 'uz' ? 'Yoriqnoma' : 'Инструкция'}</div>
                  <div className="mt-3 text-sm text-white/72">
                    {locale === 'uz' ? <>Agar Telegram avtomatik ochilmasa, <span className="font-semibold text-white">{linkData.command}</span> ni qolda yuboring va shu profil telefon raqamini jonating.</> : <>Если Telegram не открылся автоматически, отправьте вручную <span className="font-semibold text-white">{linkData.command}</span> и затем отправьте номер из профиля.</>}
                  </div>
                  <div className="mt-4 grid gap-3 sm:grid-cols-[1fr_auto]">
                    <div className="rounded-2xl border border-white/8 bg-black/20 px-4 py-3 text-lg font-semibold tracking-[0.2em] text-white">{linkData.link_code}</div>
                    <Button variant="secondary" size="sm" onClick={() => handleCopy(linkData.link_code)}>
                      <Copy className="mr-2 h-4 w-4" /> {locale === 'uz' ? 'Nusxalash' : 'Скопировать'}
                    </Button>
                  </div>
                </div>
              ) : null}

              {telegramError ? <div className="mt-4 rounded-2xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-100">{telegramError}</div> : null}
              {telegramInfo ? <div className="mt-4 rounded-2xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100">{telegramInfo}</div> : null}
            </div>
          </Panel>
        </div>

        <Panel title={locale === 'uz' ? 'Reviews profili' : 'Профиль reviews'} eyebrow={locale === 'uz' ? 'Public card' : 'Публичная карточка'} description={locale === 'uz' ? 'Restoran egasi review sahifasidagi logo, cover, kontaktlar va xususiyatlarni qo‘lda boshqaradi.' : 'Владелец вручную управляет логотипом, обложкой, контактами и особенностями на публичной reviews-странице.'}>
          <div className="grid gap-4 xl:grid-cols-[0.92fr_1.08fr]">
            <div className="rounded-[28px] border border-white/8 bg-black/12 p-5">
              <div className="text-[11px] font-semibold uppercase tracking-[0.28em] text-[#8fd4ff]">Live preview</div>
              <div className="mt-4 overflow-hidden rounded-[28px] border border-white/8 bg-[#08131e]">
                <div className="relative h-48 overflow-hidden" style={{ background: `linear-gradient(135deg, ${reviewsForm.primary_color || '#0f766e'}, ${reviewsForm.secondary_color || '#0f172a'})` }}>
                  {coverPreviewUrl ? <img src={coverPreviewUrl} alt="cover" className="h-full w-full object-cover opacity-90" /> : null}
                  <div className="absolute inset-0 bg-gradient-to-t from-[#08131e] via-transparent to-transparent" />
                  <div className="absolute left-5 bottom-5 flex items-end gap-4">
                    <div className="h-20 w-20 overflow-hidden rounded-[24px] border border-white/15 bg-[#0f172a] shadow-[0_18px_38px_rgba(15,23,42,0.34)]">
                      {logoPreviewUrl ? <img src={logoPreviewUrl} alt="logo" className="h-full w-full object-cover" /> : <div className="grid h-full w-full place-items-center text-xs font-black uppercase tracking-[0.22em] text-white">Logo</div>}
                    </div>
                    <div>
                      <div className="text-[11px] font-bold uppercase tracking-[0.24em] text-white/60">{reviewsForm.review_category || 'Restaurant profile'}</div>
                      <div className="mt-2 text-2xl font-black tracking-[-0.05em] text-white">{workspace.selectedRestaurant?.name || 'Restaurant'}</div>
                      <div className="mt-1 text-sm text-white/72">{reviewsForm.review_short_description || 'Manual profile card for reviews hub'}</div>
                    </div>
                  </div>
                </div>
                <div className="space-y-3 p-5 text-sm text-white/72">
                  <PreviewLine icon={MapPin} text={reviewsForm.address || 'Address will appear here'} />
                  <PreviewLine icon={Store} text={reviewsForm.working_hours_text || 'Working hours'} />
                  <PreviewLine icon={Palette} text={reviewsForm.average_check_text || 'Average check'} />
                </div>
              </div>

              <div className="mt-4 flex flex-wrap gap-3">
                {reviewsProfile?.review_page_url ? <a href={reviewsProfile.review_page_url} target="_blank" rel="noreferrer" className="inline-flex items-center gap-2 rounded-full border border-white/12 px-4 py-2 text-xs font-semibold text-white/72 transition hover:bg-white/8"><ExternalLink className="h-4 w-4" /> Open reviews page</a> : null}
                {reviewsProfile?.menu_url ? <a href={reviewsProfile.menu_url} target="_blank" rel="noreferrer" className="inline-flex items-center gap-2 rounded-full border border-white/12 px-4 py-2 text-xs font-semibold text-white/72 transition hover:bg-white/8"><Store className="h-4 w-4" /> Open menu</a> : null}
              </div>
            </div>

            <div>
              {reviewsLoading ? <div className="rounded-[28px] border border-white/8 bg-black/12 p-5 text-sm text-white/55">Loading reviews profile settings...</div> : null}
              {!reviewsLoading ? (
                <div className="grid gap-4 md:grid-cols-2">
                  <Field label="Category" value={reviewsForm.review_category} onChange={(value) => handleReviewsField('review_category', value)} placeholder="Restaurant, sushi bar, cafe" />
                  <Field label="Short description" value={reviewsForm.review_short_description} onChange={(value) => handleReviewsField('review_short_description', value)} placeholder="Family restaurant with handmade pasta" />
                  <Field label="Phone" value={reviewsForm.phone_number} onChange={(value) => handleReviewsField('phone_number', value)} placeholder="+998 90 000 00 00" />
                  <Field label="Working hours" value={reviewsForm.working_hours_text} onChange={(value) => handleReviewsField('working_hours_text', value)} placeholder="Open till 00:00" />
                  <Field label="Average check" value={reviewsForm.average_check_text} onChange={(value) => handleReviewsField('average_check_text', value)} placeholder="130000-250000 so'm" />
                  <Field label="Map link" value={reviewsForm.map_link} onChange={(value) => handleReviewsField('map_link', value)} placeholder="Paste Yandex/Google Maps link" />
                  <Field label="Primary color" value={reviewsForm.primary_color} onChange={(value) => handleReviewsField('primary_color', value)} placeholder="#0f766e" />
                  <Field label="Secondary color" value={reviewsForm.secondary_color} onChange={(value) => handleReviewsField('secondary_color', value)} placeholder="#0f172a" />
                  <Field label="Telegram link" value={reviewsForm.telegram_url} onChange={(value) => handleReviewsField('telegram_url', value)} placeholder="https://t.me/..." />
                  <Field label="Instagram link" value={reviewsForm.instagram_url} onChange={(value) => handleReviewsField('instagram_url', value)} placeholder="https://instagram.com/..." />
                  <Field label="WhatsApp link" value={reviewsForm.whatsapp_url} onChange={(value) => handleReviewsField('whatsapp_url', value)} placeholder="https://wa.me/..." />
                  <div className="rounded-[24px] border border-white/8 bg-black/12 p-4">
                    <div className="text-xs uppercase tracking-[0.24em] text-white/40">Logo</div>
                    <label className="mt-3 flex cursor-pointer items-center gap-2 rounded-2xl border border-dashed border-white/14 px-4 py-3 text-sm text-white/72 transition hover:bg-white/6">
                      <Camera className="h-4 w-4" />
                      <span>{logoFile?.name || 'Upload square logo'}</span>
                      <input type="file" accept="image/*" className="hidden" onChange={(event) => {
                        const file = event.target.files?.[0] || null;
                        setLogoFile(file);
                        setReviewsForm((current) => ({ ...current, clear_reviews_logo: false }));
                      }} />
                    </label>
                    {reviewsProfile?.reviews_logo_url || logoFile ? <label className="mt-3 flex items-center gap-2 text-xs text-white/55"><input type="checkbox" checked={reviewsForm.clear_reviews_logo} onChange={(event) => handleReviewsField('clear_reviews_logo', event.target.checked)} /> Remove current logo</label> : null}
                  </div>
                  <div className="rounded-[24px] border border-white/8 bg-black/12 p-4">
                    <div className="text-xs uppercase tracking-[0.24em] text-white/40">Cover</div>
                    <label className="mt-3 flex cursor-pointer items-center gap-2 rounded-2xl border border-dashed border-white/14 px-4 py-3 text-sm text-white/72 transition hover:bg-white/6">
                      <Camera className="h-4 w-4" />
                      <span>{coverFile?.name || 'Upload hero cover'}</span>
                      <input type="file" accept="image/*" className="hidden" onChange={(event) => {
                        const file = event.target.files?.[0] || null;
                        setCoverFile(file);
                        setReviewsForm((current) => ({ ...current, clear_reviews_cover: false }));
                      }} />
                    </label>
                    {reviewsProfile?.reviews_cover_url || coverFile ? <label className="mt-3 flex items-center gap-2 text-xs text-white/55"><input type="checkbox" checked={reviewsForm.clear_reviews_cover} onChange={(event) => handleReviewsField('clear_reviews_cover', event.target.checked)} /> Remove current cover</label> : null}
                  </div>
                  <div className="md:col-span-2">
                    <TextareaField label="Address" value={reviewsForm.address} onChange={(value) => handleReviewsField('address', value)} placeholder="Mirabad district, Amir Temur avenue, 22/5" rows={3} />
                  </div>
                  <div className="md:col-span-2">
                    <TextareaField label="Features" value={reviewsForm.review_features} onChange={(value) => handleReviewsField('review_features', value)} placeholder={'Delivery\nCoffee to go\nPet friendly'} rows={5} />
                  </div>
                </div>
              ) : null}

              <div className="mt-4 flex flex-wrap gap-3">
                <Button onClick={handleSaveReviewsProfile} disabled={!workspace.selectedRestaurantId || reviewsSaving || reviewsLoading}>
                  {reviewsSaving ? 'Saving...' : 'Save reviews profile'}
                </Button>
              </div>

              {reviewsError ? <div className="mt-4 rounded-2xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-100">{reviewsError}</div> : null}
              {reviewsInfo ? <div className="mt-4 rounded-2xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100">{reviewsInfo}</div> : null}
            </div>
          </div>
        </Panel>
      </div>
    </AppShell>
  );
}

function Field({ label, value, onChange, placeholder }: { label: string; value: string; onChange: (value: string) => void; placeholder?: string }) {
  return (
    <label className="block rounded-[24px] border border-white/8 bg-black/12 p-4">
      <div className="text-xs uppercase tracking-[0.24em] text-white/40">{label}</div>
      <input value={value} onChange={(event) => onChange(event.target.value)} placeholder={placeholder} className="mt-3 w-full rounded-2xl border border-white/10 bg-black/20 px-4 py-3 text-sm text-white outline-none placeholder:text-white/28 focus:border-[#8fd4ff]/35" />
    </label>
  );
}

function TextareaField({ label, value, onChange, placeholder, rows = 4 }: { label: string; value: string; onChange: (value: string) => void; placeholder?: string; rows?: number }) {
  return (
    <label className="block rounded-[24px] border border-white/8 bg-black/12 p-4">
      <div className="text-xs uppercase tracking-[0.24em] text-white/40">{label}</div>
      <textarea value={value} onChange={(event) => onChange(event.target.value)} placeholder={placeholder} rows={rows} className="mt-3 w-full rounded-2xl border border-white/10 bg-black/20 px-4 py-3 text-sm text-white outline-none placeholder:text-white/28 focus:border-[#8fd4ff]/35" />
    </label>
  );
}

function PreviewLine({ icon: Icon, text }: { icon: any; text: string }) {
  return (
    <div className="flex items-center gap-2">
      <Icon className="h-4 w-4 text-white/42" />
      <span>{text}</span>
    </div>
  );
}
